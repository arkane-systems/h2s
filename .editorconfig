resharper_inheritdoc_consider_usage_highlighting = hint
resharper_internal_or_private_member_not_documented_highlighting = hint
resharper_lambda_expression_can_be_made_static_highlighting = suggestion
resharper_local_function_can_be_made_static_highlighting = warning
resharper_loop_can_be_partly_converted_to_query_highlighting = hint
resharper_member_can_be_file_local_highlighting = suggestion
resharper_member_can_be_internal_highlighting = hint
resharper_nullable_warning_suppression_is_used_highlighting = hint
resharper_parameter_type_can_be_enumerable_global_highlighting = suggestion
