resharper_csharp_align_multiline_for_stmt = true
resharper_csharp_align_multiline_list_pattern = true
resharper_csharp_align_multiline_parameter = true
resharper_csharp_align_multiline_property_pattern = true
resharper_csharp_align_multiline_switch_expression = true
resharper_csharp_align_multiple_declaration = true
resharper_csharp_align_multline_type_parameter_constrains = true
resharper_csharp_align_multline_type_parameter_list = true
resharper_csharp_align_tuple_components = true
resharper_csharp_arguments_anonymous_function = named
resharper_csharp_arguments_literal = named
resharper_csharp_arguments_named = named
resharper_csharp_arguments_other = named
resharper_csharp_arguments_skip_single = true
resharper_csharp_arguments_string_literal = named
resharper_csharp_blank_lines_after_control_transfer_statements = 1
resharper_csharp_blank_lines_around_single_line_local_method = 1
resharper_csharp_blank_lines_before_block_statements = 1
resharper_csharp_blank_lines_before_case = 1
resharper_csharp_blank_lines_before_control_transfer_statements = 1
resharper_csharp_blank_lines_before_single_line_comment = 1
resharper_csharp_default_value_when_type_not_evident = default_expression
resharper_csharp_empty_block_style = together
resharper_csharp_for_built_in_types = use_var_when_evident
resharper_csharp_for_other_types = use_var_when_evident
resharper_csharp_for_simple_types = use_var_when_evident
resharper_csharp_instance_members_qualify_members = field, property, event, method
resharper_csharp_int_align_assignments = true
resharper_csharp_int_align_binary_expressions = true
resharper_csharp_int_align_comments = true
resharper_csharp_int_align_fields = true
resharper_csharp_int_align_invocations = true
resharper_csharp_int_align_methods = true
resharper_csharp_int_align_nested_ternary = true
resharper_csharp_int_align_parameters = true
resharper_csharp_int_align_properties = true
resharper_csharp_int_align_property_patterns = true
resharper_csharp_int_align_switch_expressions = true
resharper_csharp_int_align_switch_sections = true
resharper_csharp_int_align_variables = true
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1
resharper_csharp_keep_existing_declaration_parens_arrangement = false
resharper_csharp_keep_existing_embedded_arrangement = false
resharper_csharp_keep_existing_expr_member_arrangement = false
resharper_csharp_keep_existing_initializer_arrangement = false
resharper_csharp_keep_existing_invocation_parens_arrangement = false
resharper_csharp_keep_existing_list_patterns_arrangement = false
resharper_csharp_keep_existing_primary_constructor_declaration_parens_arrangement = false
resharper_csharp_keep_existing_property_patterns_arrangement = false
resharper_csharp_keep_existing_switch_expression_arrangement = false
resharper_csharp_line_feed_at_file_end = true
resharper_csharp_place_comments_at_first_column = true
resharper_csharp_place_field_attribute_on_same_line = if_owner_is_single_line
resharper_csharp_place_linq_into_on_new_line = false
resharper_csharp_place_simple_embedded_block_on_same_line = true
resharper_csharp_place_simple_enum_on_single_line = true
resharper_csharp_place_simple_method_on_single_line = true
resharper_csharp_place_simple_switch_expression_on_single_line = true
resharper_csharp_space_before_checked_parentheses = true
resharper_csharp_space_before_default_parentheses = true
resharper_csharp_space_before_empty_method_call_parentheses = true
resharper_csharp_space_before_empty_method_parentheses = true
resharper_csharp_space_before_method_call_parentheses = true
resharper_csharp_space_before_method_parentheses = true
resharper_csharp_space_before_nameof_parentheses = true
resharper_csharp_space_before_new_parentheses = true
resharper_csharp_space_before_sizeof_parentheses = true
resharper_csharp_space_before_typeof_parentheses = true
resharper_csharp_static_members_qualify_members = field, property, event, method
resharper_csharp_trailing_comma_in_multiline_lists = true
resharper_csharp_wrap_before_arrow_with_expressions = true
resharper_csharp_wrap_before_binary_pattern_op = false
resharper_csharp_wrap_chained_binary_expressions = chop_if_long
resharper_csharp_wrap_chained_binary_patterns = chop_if_long
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_extends_list_style = chop_if_long
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_indent_anonymous_method_block = true
resharper_indent_nested_for_stmt = true
resharper_indent_nested_foreach_stmt = true
resharper_indent_nested_while_stmt = true
resharper_indent_preprocessor_other = usual_indent

