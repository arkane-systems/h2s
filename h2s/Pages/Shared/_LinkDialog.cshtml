@model LinkDialogModel
@* The shared add/edit link dialog, driven by wwwroot/js/modules/link-dialog.js. URL first: the page title and a selfh.st
   icon are suggested from it, and the preview is the server-rendered tile. *@
<div class="modal fade" id="link-dialog" tabindex="-1" aria-labelledby="link-dialog-title" aria-hidden="true"
     data-link-url="@Url.Page("/Admin/Editor", "Link")"
     data-suggest-url="@Url.Page("/Admin/Editor", "SuggestLink")"
     data-preview-url="@Url.Page("/Admin/Editor", "TilePreview")"
     data-create-url="@Url.Page("/Admin/Editor", "CreateLink")"
     data-update-url="@Url.Page("/Admin/Editor", "UpdateLink")"
     data-delete-url="@Url.Page("/Admin/Editor", "DeleteLink")"
     data-restore-url="@Url.Page("/Admin/Editor", "RestoreLink")"
     data-search-icons-url="@Url.Page("/Admin/Editor", "SearchIcons")"
     data-monitors-url="@(Model.IsUptimeKumaConfigured ? Url.Page("/Admin/Editor", "KumaMonitors") : "")">
    <div class="modal-dialog modal-dialog-scrollable">
        <form class="modal-content" novalidate>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="link-dialog-title">Add link</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" role="alert" data-role="error"></div>

                <div class="mb-3">
                    <label for="link-dialog-url" class="form-label">URL</label>
                    <input type="url" class="form-control" id="link-dialog-url" name="url" required
                           pattern="https?://.+" placeholder="https://" autocomplete="off" />
                    <div class="invalid-feedback">Enter an address starting with http:// or https://.</div>
                    <div class="form-text" data-role="suggest-status" aria-live="polite"></div>
                </div>

                <div class="mb-3">
                    <label for="link-dialog-label" class="form-label">Label</label>
                    <input type="text" class="form-control" id="link-dialog-label" name="label" required maxlength="200" autocomplete="off" />
                    <div class="invalid-feedback">A label is required.</div>
                </div>

                <div class="mb-3">
                    <label for="link-dialog-description" class="form-label">Description <span class="text-muted">(optional)</span></label>
                    <input type="text" class="form-control" id="link-dialog-description" name="description" maxlength="200" autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label for="link-dialog-icon" class="form-label">Icon <span class="text-muted">(optional)</span></label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="link-dialog-icon" name="iconName" autocomplete="off"
                               aria-describedby="link-dialog-icon-help" />
                        <button type="button" class="btn btn-outline-secondary" data-role="browse-icons" aria-expanded="false"
                                aria-controls="link-dialog-icon-picker">Browse…</button>
                    </div>
                    <div class="form-text" id="link-dialog-icon-help">
                        A <a href="https://selfh.st/icons/" target="_blank" rel="noopener">selfh.st icon</a> name, such as
                        <code>jellyfin</code>.
                    </div>
                    <div class="icon-picker d-none" id="link-dialog-icon-picker" data-role="icon-picker">
                        <input type="search" class="form-control form-control-sm" placeholder="Search selfh.st icons"
                               aria-label="Search selfh.st icons" data-role="icon-search" autocomplete="off" />
                        <div class="icon-picker-results" data-role="icon-results" aria-live="polite"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="link-dialog-icon-url" class="form-label">Icon image URL <span class="text-muted">(optional)</span></label>
                    <input type="url" class="form-control" id="link-dialog-icon-url" name="iconUrl" pattern="https?://.+"
                           autocomplete="off" aria-describedby="link-dialog-icon-url-help" />
                    <div class="invalid-feedback">Enter an address starting with http:// or https://.</div>
                    <div class="form-text" id="link-dialog-icon-url-help">Used when there's no selfh.st icon, such as the site's own favicon.</div>
                </div>

                @if (Model.IsUptimeKumaConfigured)
                {
                    @* The select picks from every monitor Kuma reports; the text field, which is what's posted, is shown for
                       an ID Kuma doesn't report, or when the monitors can't be listed. *@
                    <div class="mb-3">
                        <label for="link-dialog-monitor-select" class="form-label">Uptime Kuma monitor <span class="text-muted">(optional)</span></label>
                        <select class="form-select" id="link-dialog-monitor-select" data-role="monitor-select">
                            <option value="">None</option>
                            <option value="other">Another monitor ID…</option>
                        </select>
                        <input type="text" class="form-control mt-2 d-none" id="link-dialog-monitor" name="monitorId" inputmode="numeric"
                               pattern="\s*[0-9]*\s*" autocomplete="off" aria-label="Uptime Kuma monitor ID" />
                        <div class="invalid-feedback">Use a positive whole number, or leave it blank.</div>
                        <div class="form-text" data-role="monitor-status"></div>
                    </div>
                }

                <div class="mb-3">
                    <label for="link-dialog-category" class="form-label">Category</label>
                    <select class="form-select" id="link-dialog-category" name="categoryId" required>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name@(category.IsAdminCategory ? " (admin)" : "")</option>
                        }
                    </select>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="link-dialog-new-tab" name="openInNewTab" value="true" />
                    <label class="form-check-label" for="link-dialog-new-tab">Open in a new tab</label>
                </div>

                <div class="form-label" id="link-dialog-preview-label">Preview</div>
                @* Inert, so the preview's link can't be focused or followed. *@
                <div class="link-dialog-preview" data-role="preview" aria-labelledby="link-dialog-preview-label" inert></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger me-auto d-none" data-role="delete">Delete</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" data-role="save">Save</button>
            </div>
        </form>
    </div>
</div>
