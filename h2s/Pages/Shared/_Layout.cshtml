@using h2s.Models
@using h2s.Services
@inject DashboardSettingsService SettingsService
@{
    var settings = await SettingsService.GetSettingsAsync();
    var appTitle = $"h2s - {settings.Title}";
    var pageTitle = ViewData["Title"]?.ToString();
    var fullPageTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? appTitle
        : $"{appTitle} - {pageTitle}";
    // This browser's own color mode, from the toggle's cookie, wins over the site's.
    var viewerColorMode = ViewerPreferences.ReadColorMode(Context.Request);
    var colorModeInt = (int)(viewerColorMode ?? settings.ColorMode);
    var isEditMode = ViewData["IsEditMode"] is true;
    // The list view is editing too, so it offers Done (back to the dashboard) rather than Edit.
    var isListView = ViewData["IsListView"] is true;
    var (colorModeIcon, colorModeTitle) = ViewerPreferences.DescribeToggle(viewerColorMode, settings.ColorMode);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullPageTitle</title>
    @* Installable as an app (Pages/Manifest). The installed app's title bar follows this browser's color mode, or the
       system's in Auto. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    @switch (viewerColorMode ?? settings.ColorMode)
    {
        case ColorMode.Light:
            <meta name="theme-color" content="@h2s.Pages.ManifestModel.LightThemeColor" />
            break;
        case ColorMode.Dark:
            <meta name="theme-color" content="@h2s.Pages.ManifestModel.DarkThemeColor" />
            break;
        default:
            <meta name="theme-color" content="@h2s.Pages.ManifestModel.LightThemeColor" media="(prefers-color-scheme: light)" />
            <meta name="theme-color" content="@h2s.Pages.ManifestModel.DarkThemeColor" media="(prefers-color-scheme: dark)" />
            break;
    }
    <!-- Apply theme before stylesheets load to prevent flash of unstyled content -->
    <script>
        (function () {
            const mode = @colorModeInt;
            // 0=Auto, 1=Light, 2=Dark
            let theme = mode === 1 ? 'light' : mode === 2 ? 'dark'
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* h2s.styles.css is the scoped-CSS bundle generated at build time, so it never exists on disk under wwwroot. *@
    @* ReSharper disable once Html.PathError *@
    <link rel="stylesheet" href="~/h2s.styles.css" asp-append-version="true" />
</head>
<body>
    @* The first stop for keyboard users: past the navbar to the page itself. *@
    <a class="skip-link visually-hidden-focusable" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 mw-100 overflow-hidden" asp-area="" asp-page="/Index">
                    <img src="~/favicon.png" alt="" class="navbar-favicon flex-shrink-0" />
                    <span class="d-flex flex-column overflow-hidden">
                        <span class="text-truncate"><strong>h2s</strong> - <span data-role="site-title">@settings.Title</span></span>
                        @* Always rendered, so Settings can show a motto without a reload. *@
                        <small class="text-muted text-wrap @(string.IsNullOrWhiteSpace(settings.Motto) ? "d-none" : "")"
                               data-role="site-motto">@settings.Motto</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbar-content"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbar-content">
                    <div class="me-auto"></div>
                    @* Edit/Done is the primary action, so it sits at the far right. The list view is reached from edit mode. *@
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <button id="color-mode-toggle"
                                    class="nav-link icon-nav-link"
                                    data-viewer-mode="@(viewerColorMode?.ToString() ?? "")"
                                    data-site-mode="@settings.ColorMode"
                                    title="@colorModeTitle"
                                    aria-label="@colorModeTitle">@colorModeIcon</button>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link icon-nav-link" asp-area="" asp-page="/Admin/Settings" title="Settings" aria-label="Settings">⚙</a>
                        </li>
                        <li class="nav-item ms-sm-2">
                            @if (isEditMode || isListView)
                            {
                                <a class="btn btn-sm btn-primary" asp-area="" asp-page="/Index"
                                   title="@(isListView ? "Close the list view" : "Leave edit mode")">Done</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-page="/Index" asp-route-edit="true"
                                   title="Edit the dashboard">Edit</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* Every page carries an antiforgery token here; wwwroot/js/api.js sends it with each JSON handler request. *@
    <form id="antiforgery-token" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="app-background" aria-hidden="true"></div>

    <div class="container app-content">
        <main role="main" class="py-3" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    @* wwwroot/js/modules/toast.js shows its toasts here. *@
    <div id="toast-host" class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" aria-atomic="false"></div>

    @* Modal dialogs render here, outside .app-content: its z-index makes a stacking context that would trap a modal
       beneath Bootstrap's backdrop. *@
    @await RenderSectionAsync("Dialogs", required: false)

    <footer class="border-top footer text-muted py-3">
        <div class="container">
            &copy; 2026 Arkane Systems & Alistair J. R. Young - <strong>h2s</strong> <span data-role="app-version">@AppVersion.Current</span> - vibe-coded with <span class="text-danger">♥</span> and Claude, with a little help from GitHub Copilot
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/lowpoly.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Low-poly background palettes per theme
            const backgroundColors = {
                light: ['#1e1b4b', '#fbbf24'],
                dark:  ['#1f1b5f', '#6d28d9', '#d8b4fe']
            };

            const backgroundHost = document.querySelector('.app-background');
            const header = document.querySelector('header');
            const footer = document.querySelector('footer');

            // One seed per page load: redrawing for a new size keeps the triangles already drawn where they were.
            const seed = Math.floor(Math.random() * 2 ** 32);
            let drawn = { width: 0, height: 0 };

            // Sizes the background to the page and draws it, unless it is already drawn at that size. A theme change forces a
            // redraw, since the colours change.
            const renderPattern = ({ force = false } = {}) => {
                if (!backgroundHost || !window.h2sLowPoly) return;

                // Measure with the background collapsed, so its old height doesn't hold the page open when content shrinks.
                backgroundHost.style.height = '0px';
                const top = Math.max(header?.offsetHeight ?? 0, 0);
                const footerHeight = Math.max(footer?.offsetHeight ?? 0, 0);
                const pageHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
                const height = Math.max(pageHeight - top - footerHeight, 320);
                const width = Math.max(document.documentElement.clientWidth, 320);

                backgroundHost.style.top = `${top}px`;
                backgroundHost.style.height = `${height}px`;

                if (!force && width === drawn.width && height === drawn.height) return;
                drawn = { width, height };

                const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                const colors = isDark ? backgroundColors.dark : backgroundColors.light;

                backgroundHost.innerHTML = '';
                const svg = window.h2sLowPoly.createSvg({
                    width,
                    height,
                    cellSize: 170,
                    variance: 0.75,
                    colors,
                    seed
                });
                svg.setAttribute('preserveAspectRatio', 'xMidYMid slice');
                svg.classList.add('app-background-svg');
                backgroundHost.appendChild(svg);
            };

            renderPattern({ force: true });
            window.addEventListener('resize', () => renderPattern());
            window.addEventListener('app-background-refresh', () => renderPattern({ force: true }));

            // Pages that build their content in script (the list view, edit mode adding links) change height after load.
            let resizeTimer = 0;
            new ResizeObserver(() => {
                window.clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(() => renderPattern(), 100);
            }).observe(document.body);

            // Color mode: the site's (Settings → Appearance), unless this browser picked its own with the toggle, which keeps it
            // in a cookie the server reads (ViewerPreferences). The toggle cycles the site default, light, dark and auto, then
            // back to the site default. The titles match ViewerPreferences.DescribeToggle.
            const toggleBtn = document.getElementById('color-mode-toggle');
            const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');
            const colorModeIcons = { Auto: '◑', Light: '☀', Dark: '☾' };
            const nextViewerMode = { '': 'Light', Light: 'Dark', Dark: 'Auto', Auto: '' };

            const effectiveMode = () => toggleBtn?.dataset.viewerMode || toggleBtn?.dataset.siteMode || 'Auto';

            const applyTheme = () => {
                const mode = effectiveMode();
                const theme = mode === 'Light' ? 'light'
                    : mode === 'Dark' ? 'dark'
                    : (systemDarkQuery.matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
                renderPattern({ force: true });

                // An installed app's title bar follows the theme too.
                document.querySelectorAll('meta[name="theme-color"]').forEach(meta => meta.remove());
                const themeColor = document.createElement('meta');
                themeColor.name = 'theme-color';
                themeColor.content = theme === 'dark'
                    ? '@h2s.Pages.ManifestModel.DarkThemeColor'
                    : '@h2s.Pages.ManifestModel.LightThemeColor';
                document.head.append(themeColor);
            };

            const showToggle = () => {
                if (!toggleBtn) return;
                const viewer = toggleBtn.dataset.viewerMode;
                const site = toggleBtn.dataset.siteMode;
                const [icon, title] = {
                    '': [colorModeIcons[site] ?? '◑', `Site default (${site}). Click for light in this browser.`],
                    Light: ['☀', 'Light in this browser. Click for dark.'],
                    Dark: ['☾', 'Dark in this browser. Click for auto.'],
                    Auto: ['◑', 'Auto in this browser. Click to follow the site default.']
                }[viewer] ?? ['◑', ''];
                toggleBtn.textContent = icon;
                toggleBtn.title = title;
                toggleBtn.setAttribute('aria-label', title);
            };

            // Following the site default clears the cookie; anything else keeps it for a year.
            const setViewerMode = mode => {
                toggleBtn.dataset.viewerMode = mode;
                document.cookie = mode
                    ? `@(ViewerPreferences.ColorModeCookie)=${mode.toLowerCase()}; path=/; max-age=31536000; samesite=lax`
                    : `@(ViewerPreferences.ColorModeCookie)=; path=/; max-age=0; samesite=lax`;
                showToggle();
                applyTheme();
            };

            // Auto follows the system's light or dark setting as it changes.
            systemDarkQuery.addEventListener('change', () => {
                if (effectiveMode() === 'Auto') applyTheme();
            });

            // Settings calls this after saving the Appearance section. A browser with its own mode keeps it.
            window.h2sColorMode = {
                setSiteDefault: name => {
                    if (!toggleBtn) return;
                    toggleBtn.dataset.siteMode = name;
                    showToggle();
                    applyTheme();
                }
            };

            toggleBtn?.addEventListener('click', () => setViewerMode(nextViewerMode[toggleBtn.dataset.viewerMode] ?? ''));
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

