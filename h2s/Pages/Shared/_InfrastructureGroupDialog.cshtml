@* The add/edit infrastructure group dialog on the Settings page, driven by wwwroot/js/modules/infrastructure-groups.js.
   The monitor picker lists every monitor Kuma reports; the text field, which is what's posted, takes any other ID. *@
<div class="modal fade" id="infrastructure-group-dialog" tabindex="-1" aria-labelledby="infrastructure-group-dialog-title" aria-hidden="true"
     data-monitors-url="@Url.Page("/Admin/Editor", "KumaMonitors")">
    <div class="modal-dialog">
        <form class="modal-content" novalidate>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="infrastructure-group-dialog-title">Add infrastructure group</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" role="alert" data-role="error"></div>

                <div class="mb-3">
                    <label for="infrastructure-group-name" class="form-label">Name</label>
                    <input type="text" class="form-control" id="infrastructure-group-name" name="name" required maxlength="100" autocomplete="off" />
                    <div class="invalid-feedback">A name is required.</div>
                </div>

                <div class="mb-1">
                    <label for="infrastructure-group-monitor-select" class="form-label">Uptime Kuma monitor</label>
                    <select class="form-select" id="infrastructure-group-monitor-select" data-role="monitor-select">
                        <option value="">Choose a monitor…</option>
                        <option value="other">Another monitor ID…</option>
                    </select>
                    <input type="text" class="form-control mt-2 d-none" id="infrastructure-group-monitor" name="monitorId" inputmode="numeric"
                           pattern="\s*[0-9]+\s*" autocomplete="off" aria-label="Uptime Kuma monitor ID" />
                    <div class="form-text" data-role="monitor-status"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger me-auto d-none" data-role="delete">Delete</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>
