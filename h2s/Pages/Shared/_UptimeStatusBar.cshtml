@using h2s.Panels
@model StatusBarPanelModel
@* The status bar panel: a status badge, and optionally an uptime badge, per infrastructure group. It links to the Kuma
   status page when a slug is configured; otherwise it isn't clickable. *@
@{
    void RenderBadges()
    {
        <div class="category-box-body">
            <div class="uptime-badge-list">
                @foreach (var item in Model.Items)
                {
                    <div class="uptime-badge-group">
                        <div class="uptime-badge-label">@item.Name</div>
                        <div class="uptime-badge-pair">
                            <img src="@item.StatusBadgeUrl" alt="@($"{item.Name} status")" loading="lazy" />
                            @if (item.UptimeBadgeUrl is not null)
                            {
                                <img src="@item.UptimeBadgeUrl" alt="@($"{item.Name} uptime")" loading="lazy" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
@if (Model.StatusPageUrl is not null)
{
    <a class="uptime-status-bar uptime-status-bar-link category-box border text-decoration-none" href="@Model.StatusPageUrl" target="_blank" rel="noopener noreferrer"
       title="Open the Uptime Kuma status page">
        @{ RenderBadges(); }
        <span class="visually-hidden">Open the Uptime Kuma status page</span>
    </a>
}
else
{
    <div class="uptime-status-bar uptime-status-bar-static category-box border">
        @{ RenderBadges(); }
    </div>
}
