@model LinkTile
@* One link on the dashboard: icon (or fallback dot), label, description, widgets and External flag. *@
<a class="link-block text-decoration-none text-body" href="@Model.Link.Url"
   target="@(Model.Link.OpenInNewTab ? "_blank" : null)" rel="@(Model.Link.OpenInNewTab ? "noopener noreferrer" : null)">
    @if (Model.IsExternal)
    {
        <span class="link-external-flag" title="External site">External</span>
    }
    <div class="link-block-icon-wrap">
        @* A selfh.st icon, else the link's own icon URL, else a dot. wwwroot/js/site.js swaps in the dot if the image fails. *@
        @if (!string.IsNullOrWhiteSpace(Model.Link.GetIconUrl()))
        {
            <img class="link-block-icon" src="@Model.Link.GetIconUrl()" alt="" loading="lazy" />
        }
        else
        {
            <span class="link-block-icon-fallback" aria-hidden="true">•</span>
        }
    </div>
    <div class="link-block-content">
        <span class="link-block-title">@Model.Link.Label</span>
        @if (!string.IsNullOrWhiteSpace(Model.Link.Description))
        {
            <span class="link-block-description">@Model.Link.Description</span>
        }
        @if (Model.Widgets.Count > 0)
        {
            <partial name="_LinkWidgets" model="Model.Widgets" />
        }
        @if (Model.Link.OpenInNewTab)
        {
            <span class="visually-hidden">(opens in a new tab)</span>
        }
    </div>
</a>
