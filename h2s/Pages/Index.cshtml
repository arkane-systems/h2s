@page
@using h2s.Models
@using h2s.Panels
@using h2s.Services
@model IndexModel
@{
    ViewData["Title"] = "";
    ViewData["IsEditMode"] = Model.IsEditMode;
    var adminSectionStarted = false;
    var hasRenderedRegularCategory = false;
}

@if (Model.IsEditMode)
{
    <div id="edit-mode" class="edit-mode-banner category-box border"
         data-reorder-categories-url="@Url.Page("/Admin/Editor", "ReorderCategories")"
         data-reorder-links-url="@Url.Page("/Admin/Editor", "ReorderLinks")"
         data-reorder-panels-url="@Url.Page("/Admin/Editor", "ReorderPanels")">
        <div class="category-box-body d-flex flex-wrap align-items-center gap-2">
            <span class="me-auto">
                <strong>Edit mode.</strong> Click a tile, or a category's or panel's <span aria-hidden="true">✎</span>, to change it. Drag the
                <span aria-hidden="true">⠿</span> handles, or focus one and use the arrow keys, to rearrange categories, links and the
                panels above and below them. Changes save as you go.
            </span>
            <button type="button" class="btn btn-sm btn-outline-primary" data-role="add-category">+ Add category</button>
            <button type="button" class="btn btn-sm btn-outline-primary" data-role="add-panel">+ Add panel</button>
            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Editor" title="All links in a filterable table">List view</a>
        </div>
    </div>
}

<partial name="_PanelZone" model="new PanelZoneModel(PanelZone.Top, Model.TopPanels, Model.IsEditMode)" />

<div class="category-grid @(Model.IsEditMode ? "is-editing" : "")" data-collapse-cookie="@ViewerPreferences.CollapsedCategoriesCookie">
@foreach (var category in Model.Categories)
{
    @if (category.IsAdminCategory && hasRenderedRegularCategory && !adminSectionStarted)
    {
        <div class="category-grid-break" aria-hidden="true"></div>
        adminSectionStarted = true;
    }

    var isCollapsed = Model.CollapsedCategoryIds.Contains(category.Id);

    <section class="category-box border @(category.IsAdminCategory ? "category-box-admin" : "") @(isCollapsed ? "is-collapsed" : "")"
             data-category-id="@category.Id"
             data-admin-category="@(category.IsAdminCategory ? "true" : "false")">
        <header class="category-box-header">
            @if (Model.IsEditMode)
            {
                <button type="button" class="drag-handle category-drag-handle" title="Drag to move" aria-label="Move category @category.Name">⠿</button>
                <h2 class="h5 mb-0">@category.Name</h2>
                <button type="button" class="category-edit-button ms-auto" title="Edit category" aria-label="Edit category @category.Name"
                        data-role="edit-category">✎</button>
            }
            else
            {
                @* The title is the collapse toggle (category-collapse.js); a collapsed category shows how many links it hides. *@
                <h2 class="h5 mb-0 category-title">
                    <button type="button" class="category-collapse-button" aria-expanded="@(isCollapsed ? "false" : "true")"
                            aria-controls="category-body-@category.Id">
                        <span class="category-name">@category.Name</span>
                        <span class="category-count" title="@category.Links.Count links">@category.Links.Count</span>
                        <span class="category-chevron" aria-hidden="true">▾</span>
                    </button>
                </h2>
            }
        </header>
        <div class="category-box-body" id="category-body-@category.Id">
            <div class="link-block-list" data-category-id="@category.Id">
                @foreach (var link in category.Links)
                {
                    <partial name="@(Model.IsEditMode ? "_EditableLinkSlot" : "_LinkTile")" model="Model.CreateLinkTile(link)" />
                }
            </div>
            @if (Model.IsEditMode)
            {
                <button type="button" class="btn btn-sm btn-link link-add-button" data-role="add-link">+ Add link</button>
            }
        </div>
    </section>

    @if (!category.IsAdminCategory)
    {
        hasRenderedRegularCategory = true;
    }
}
</div>

<partial name="_PanelZone" model="new PanelZoneModel(PanelZone.Bottom, Model.BottomPanels, Model.IsEditMode)" />

@section Dialogs {
    @if (Model.IsEditMode)
    {
        <partial name="_LinkDialog" model="new LinkDialogModel(Model.Categories, Model.IsUptimeKumaConfigured)" />
        <partial name="_CategoryDialog" />
        <partial name="_PanelDialog" />
    }
    else
    {
        <partial name="_QuickLaunch" model="Model.QuickLaunchEngines" />
    }
}

@section Scripts {
    <script type="module" src="~/js/modules/search-panel.js" asp-append-version="true"></script>
    @if (Model.IsEditMode)
    {
        <script type="module" src="~/js/modules/edit-mode.js" asp-append-version="true"></script>
    }
    else
    {
        <script type="module" src="~/js/modules/quick-launch.js" asp-append-version="true"></script>
        <script type="module" src="~/js/modules/category-collapse.js" asp-append-version="true"></script>
    }
}
