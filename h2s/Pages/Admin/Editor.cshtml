@page
@model h2s.Pages.Admin.EditorModel
@using System.Text.Json
@{
    ViewData["Title"] = "Links";
    ViewData["IsListView"] = true;
}
@* The list view: every link in one filterable, sortable table, with bulk move and delete. Rows open the shared link dialog.
   wwwroot/js/modules/link-list.js renders the table from the JSON below and refreshes it from OnGetLinksAsync. *@

<div class="list-view category-box border">
    <div class="category-box-body">
        <div class="d-flex flex-wrap align-items-baseline gap-2 mb-3">
            <h1 class="h4 mb-0 me-auto">Links</h1>
            <span class="text-muted small">
                Categories, and arranging links, are in <a asp-page="/Index" asp-route-edit="true">edit mode</a>.
            </span>
        </div>

        <div class="row g-2 align-items-center mb-2">
            <div class="col-sm-6 col-lg-5">
                <input type="search" class="form-control" placeholder="Filter by label, URL, description or icon"
                       aria-label="Filter links" data-role="filter" autocomplete="off" />
            </div>
            <div class="col-sm-4 col-lg-3">
                <select class="form-select" aria-label="Category" data-role="category-filter">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name@(category.IsAdminCategory ? " (admin)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-sm-2 col-lg-4 text-sm-end">
                <button type="button" class="btn btn-primary" data-role="add-link" @(Model.Categories.Count == 0 ? "disabled" : null)>+ Add link</button>
            </div>
        </div>

        <div class="list-view-bulk d-none" data-role="bulk-bar" aria-live="polite">
            <span class="me-2" data-role="selection-count"></span>
            <select class="form-select form-select-sm w-auto" aria-label="Move selected links to" data-role="move-target">
                <option value="">Move to…</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">@category.Name@(category.IsAdminCategory ? " (admin)" : "")</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary" data-role="move-selected">Move</button>
            <button type="button" class="btn btn-sm btn-outline-danger" data-role="delete-selected">Delete</button>
            <button type="button" class="btn btn-sm btn-link" data-role="clear-selection">Clear selection</button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 list-view-table">
                <thead>
                    <tr>
                        <th scope="col" class="list-view-check">
                            <input class="form-check-input" type="checkbox" aria-label="Select all shown links" data-role="select-all" />
                        </th>
                        <th scope="col" class="list-view-icon"><span class="visually-hidden">Icon</span></th>
                        <th scope="col" aria-sort="none"><button type="button" class="list-view-sort" data-sort="label">Label</button></th>
                        <th scope="col" aria-sort="none"><button type="button" class="list-view-sort" data-sort="url">URL</button></th>
                        <th scope="col" aria-sort="ascending"><button type="button" class="list-view-sort" data-sort="category">Category</button></th>
                        @if (Model.IsUptimeKumaConfigured)
                        {
                            <th scope="col" aria-sort="none"><button type="button" class="list-view-sort" data-sort="monitor">Monitor</button></th>
                        }
                    </tr>
                </thead>
                <tbody data-role="rows"></tbody>
            </table>
        </div>
        <p class="text-muted text-center my-3 d-none" data-role="empty"></p>
    </div>
</div>

<script type="application/json" id="link-list-data">
    @Html.Raw(JsonSerializer.Serialize(new
    {
        links = Model.Links,
        urls = new
        {
            links = Url.Page("/Admin/Editor", "Links"),
            moveLinks = Url.Page("/Admin/Editor", "MoveLinks"),
            deleteLinks = Url.Page("/Admin/Editor", "DeleteLinks"),
            restoreLink = Url.Page("/Admin/Editor", "RestoreLink"),
        },
        showMonitors = Model.IsUptimeKumaConfigured,
    }, JsonSerializerOptions.Web))
</script>

@section Dialogs {
    <partial name="_LinkDialog" model="new LinkDialogModel(Model.Categories, Model.IsUptimeKumaConfigured)" />
}

@section Scripts {
    <script type="module" src="~/js/modules/link-list.js" asp-append-version="true"></script>
}
