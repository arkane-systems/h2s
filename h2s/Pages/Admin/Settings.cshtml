@page
@model h2s.Pages.Admin.SettingsModel
@using System.Text.Json
@using h2s.Integrations.UptimeKuma
@using h2s.Models
@using h2s.Widgets.Abstractions
@{
    ViewData["Title"] = "Settings";
}
@* Settings as section cards that each save on their own (wwwroot/js/modules/settings.js), with the search engines
   (search-engines.js), the infrastructure groups (infrastructure-groups.js) and Backup (backup.js). *@

<div class="settings-page">
    <div class="d-flex flex-wrap align-items-baseline gap-3 mb-3">
        <h1 class="h3 mb-0">Settings</h1>
        <nav class="settings-index" aria-label="Settings sections">
            <a href="#general">General</a>
            <a href="#appearance">Appearance</a>
            <a href="#search">Search</a>
            <a href="#integrations">Integrations</a>
            <a href="#backup">Backup</a>
        </nav>
    </div>

    <section id="general" class="category-box border settings-card" aria-labelledby="general-title">
        <form class="category-box-body" novalidate data-role="settings-form" data-section="general"
              data-save-url="@Url.Page("/Admin/Settings", "SaveGeneral")">
            <h2 class="h5" id="general-title">General</h2>
            <div class="alert alert-danger d-none" role="alert" data-role="error"></div>

            <div class="mb-3">
                <label for="settings-title" class="form-label">Title</label>
                <input type="text" class="form-control" id="settings-title" name="title" required maxlength="100"
                       value="@Model.Settings.Title" autocomplete="off" />
                <div class="invalid-feedback">A title is required.</div>
            </div>

            <div class="mb-3">
                <label for="settings-motto" class="form-label">Motto <span class="text-muted">(optional)</span></label>
                <input type="text" class="form-control" id="settings-motto" name="motto" maxlength="200"
                       value="@Model.Settings.Motto" autocomplete="off" />
            </div>

            <div class="mb-3">
                <label for="settings-local-domain-entry" class="form-label">Local domains</label>
                <div class="form-control chip-input" data-role="chip-input">
                    <input type="text" class="chip-input-entry" id="settings-local-domain-entry" autocomplete="off"
                           placeholder="Add a domain, such as home.arpa" aria-describedby="settings-local-domains-help" />
                </div>
                <input type="hidden" name="localDomains" value="@Model.Settings.LocalDomains" data-role="chip-value" />
                <div class="form-text" id="settings-local-domains-help">
                    Links to hosts in these domains count as local; others get an External badge. Press Enter, comma or space after
                    each one.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </section>

    <section id="appearance" class="category-box border settings-card" aria-labelledby="appearance-title">
        <form class="category-box-body" novalidate data-role="settings-form" data-section="appearance"
              data-save-url="@Url.Page("/Admin/Settings", "SaveAppearance")">
            <h2 class="h5" id="appearance-title">Appearance</h2>
            <div class="alert alert-danger d-none" role="alert" data-role="error"></div>

            <div class="mb-3">
                <label for="settings-color-mode" class="form-label">Color mode</label>
                <select class="form-select" id="settings-color-mode" name="colorMode" aria-describedby="settings-color-mode-help">
                    @foreach (var mode in Enum.GetValues<ColorMode>())
                    {
                        <option value="@mode" selected="@(mode == Model.Settings.ColorMode)">@mode</option>
                    }
                </select>
                <div class="form-text" id="settings-color-mode-help">
                    The site's color mode, which every browser follows by default. Auto follows the device's light or dark setting.
                    The ◑ button in the navbar picks a mode for your browser only.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </section>

    @* The engines save as they change (search-engines.js), like the infrastructure groups. *@
    <section id="search" class="category-box border settings-card" aria-labelledby="search-title">
        <div class="category-box-body" id="search-engines"
             data-engines-url="@Url.Page("/Admin/Settings", "SearchEngines")"
             data-create-url="@Url.Page("/Admin/Settings", "CreateSearchEngine")"
             data-update-url="@Url.Page("/Admin/Settings", "UpdateSearchEngine")"
             data-delete-url="@Url.Page("/Admin/Settings", "DeleteSearchEngine")"
             data-restore-url="@Url.Page("/Admin/Settings", "RestoreSearchEngine")"
             data-reorder-url="@Url.Page("/Admin/Settings", "ReorderSearchEngines")">
            <h2 class="h5" id="search-title">Search</h2>
            <p class="text-muted small">
                The search box sends searches to the default engine. Start or end a search with an engine's shortcut, such as
                <code>!g</code>, to use that engine instead. Drag the <span aria-hidden="true">⠿</span> handles, or focus one and use the
                arrow keys, to reorder them.
            </p>
            <ul class="list-group mb-2 group-list" data-role="engine-list"></ul>
            <p class="text-muted small d-none" data-role="engine-empty">No search engines, so the search box is hidden. Add one to bring it back.</p>
            <button type="button" class="btn btn-sm btn-outline-primary" data-role="add-engine">+ Add engine</button>
        </div>
    </section>

    @* Integrations is a heading over one card per integration. integrations.js builds each card's fields from the
       integration's schema (the integrations-data JSON below) and drives Save, Test connection and Remove. *@
    <section id="integrations" class="settings-group" aria-labelledby="integrations-title"
             data-save-url="@Url.Page("/Admin/Settings", "SaveConnection")"
             data-test-url="@Url.Page("/Admin/Settings", "TestConnection")"
             data-remove-url="@Url.Page("/Admin/Settings", "RemoveConnection")">
        <h2 class="h5 settings-group-title" id="integrations-title">Integrations</h2>

        @foreach (IIntegration integration in Model.Integrations)
        {
            string cardId = $"integration-{integration.Key}";

            <section id="@cardId" class="category-box border settings-card" aria-labelledby="@(cardId)-title">
                <div class="category-box-body">
                    <form novalidate data-role="integration-form" data-integration="@integration.Key">
                        <h3 class="h5" id="@(cardId)-title">@integration.DisplayName</h3>
                        <p class="text-muted small">@integration.Description</p>
                        <p class="small d-none" data-role="state">Not set up yet. Fill in the settings and save to turn it on.</p>
                        <div class="alert alert-danger d-none" role="alert" data-role="error"></div>

                        <div data-role="fields"></div>

                        <div class="alert d-none" role="status" data-role="test-result"></div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-outline-secondary" data-role="test">Test connection</button>
                            <button type="button" class="btn btn-outline-danger ms-auto d-none" data-role="remove">Remove</button>
                        </div>

                        <div class="alert alert-warning mt-3 mb-0 d-none" role="alert" data-role="remove-confirm">
                            <p class="mb-2">
                                Remove the @integration.DisplayName connection? <span data-role="remove-what">Its settings and any secrets
                                are</span> deleted, and @integration.DisplayName is turned off.
                            </p>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-danger" data-role="remove-yes">Remove</button>
                                <button type="button" class="btn btn-sm btn-secondary" data-role="remove-no">Cancel</button>
                            </div>
                        </div>
                    </form>

                    @if (integration.Key == UptimeKumaIntegration.IntegrationKey)
                    {
                        @* The groups save as they change, apart from the settings and Save above, so a divider sets them off.
                           data-shown-with hides them while Uptime Kuma has no connection. 5d retires them. *@
                        <div id="infrastructure-groups" class="@(Model.IsUptimeKumaConfigured ? "" : "d-none")" data-shown-with="@integration.Key"
                             data-groups-url="@Url.Page("/Admin/Settings", "InfrastructureGroups")"
                             data-create-url="@Url.Page("/Admin/Settings", "CreateInfrastructureGroup")"
                             data-update-url="@Url.Page("/Admin/Settings", "UpdateInfrastructureGroup")"
                             data-delete-url="@Url.Page("/Admin/Settings", "DeleteInfrastructureGroup")"
                             data-restore-url="@Url.Page("/Admin/Settings", "RestoreInfrastructureGroup")"
                             data-reorder-url="@Url.Page("/Admin/Settings", "ReorderInfrastructureGroups")">
                            <hr class="settings-divider" />
                            <h4 class="h6">Infrastructure groups</h4>
                            <p class="text-muted small">
                                Each group shows a status and an uptime badge in the bar across the top of the dashboard. Drag the
                                <span aria-hidden="true">⠿</span> handles, or focus one and use the arrow keys, to reorder them.
                            </p>
                            <ul class="list-group mb-2 group-list" data-role="group-list"></ul>
                            <p class="text-muted small d-none" data-role="group-empty">No infrastructure groups yet.</p>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-role="add-group">+ Add group</button>
                        </div>
                    }
                </div>
            </section>
        }
    </section>

    @* Driven by wwwroot/js/modules/backup.js: upload, preview what the file holds, then confirm the replacement. *@
    <section id="backup" class="category-box border settings-card" aria-labelledby="backup-title"
             data-preview-url="@Url.Page("/Admin/Settings", "PreviewImport")"
             data-import-url="@Url.Page("/Admin/Settings", "Import")">
        <div class="category-box-body">
            <h2 class="h5" id="backup-title">Backup</h2>
            <p class="text-muted">
                Export the whole configuration (settings, categories, links, infrastructure groups, panels, search engines and
                integrations, without their secrets) as a JSON file, or import one to replace it.
            </p>

            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <a class="btn btn-outline-primary" asp-page="/Admin/Settings" asp-page-handler="Export">Export configuration</a>
                <label class="btn btn-outline-secondary mb-0" for="backup-file">Import…</label>
                <input type="file" class="visually-hidden" id="backup-file" accept=".json,application/json" data-role="backup-file" />
            </div>

            <div class="alert alert-danger d-none backup-errors" role="alert" data-role="backup-error"></div>

            <div class="card d-none" data-role="backup-preview">
                <div class="card-body">
                    <h3 class="h6" data-role="backup-file-name"></h3>
                    <p class="mb-2" data-role="backup-summary"></p>
                    <p class="text-danger mb-3" data-role="backup-warning"></p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-danger" data-role="backup-confirm">Replace everything</button>
                        <button type="button" class="btn btn-secondary" data-role="backup-cancel">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script type="application/json" id="infrastructure-groups-data">
    @Html.Raw(JsonSerializer.Serialize(Model.InfrastructureGroups.Select(g => new { g.Id, g.Name, g.MonitorId, g.SortOrder }),
                                       JsonSerializerOptions.Web))
</script>

<script type="application/json" id="integrations-data">
    @Html.Raw(JsonSerializer.Serialize(Model.IntegrationCards, JsonSerializerOptions.Web))
</script>

<script type="application/json" id="search-engines-data">
    @Html.Raw(JsonSerializer.Serialize(Model.SearchEngines.Select(e => new { e.Id, e.Name, e.UrlTemplate, e.Shortcut, e.IsDefault, e.SortOrder }),
                                       JsonSerializerOptions.Web))
</script>

@section Dialogs {
    <partial name="_InfrastructureGroupDialog" />
    <partial name="_SearchEngineDialog" />
}

@section Scripts {
    <script type="module" src="~/js/modules/settings.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/integrations.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/infrastructure-groups.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/search-engines.js" asp-append-version="true"></script>
    <script type="module" src="~/js/modules/backup.js" asp-append-version="true"></script>
}
